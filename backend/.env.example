# Base de datos — Railway usa la URL completa; Docker local usa el hostname "postgres"
DATABASE_URL=postgresql://financeapp:financeapp123@postgres:5432/financeapp_dev

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_seguro
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_seguro

# Servidor
PORT=3000
NODE_ENV=development

# CORS
FRONTEND_URL=http://localhost:5173

# Email — SMTP (Gmail: usa una App Password, no tu contraseña normal)
# Guía Gmail App Password: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
SMTP_FROM="FinanceApp" <tu@gmail.com>
